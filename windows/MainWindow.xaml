<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Рядом — личные сообщения" Width="1040" Height="760" MinWidth="760" MinHeight="640" WindowStartupLocation="CenterScreen" Background="#F5F5EF" FontFamily="Segoe UI" Foreground="#213A32">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#265C48"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="16,12"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="15"/><Setter Property="BorderBrush" Value="#D5DED5"/><Setter Property="Background" Value="White"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="15"/><Setter Property="BorderBrush" Value="#D5DED5"/><Setter Property="Background" Value="White"/></Style>
 </Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20"><Button x:Name="Logout" Content="Выйти" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#E3E9DF" Foreground="#265C48" Visibility="Collapsed"/><StackPanel><TextBlock Text="Рядом." FontSize="34" FontWeight="SemiBold"/><TextBlock x:Name="Me" Text="Личные сообщения" Foreground="#758478"/></StackPanel></DockPanel>
  <Grid x:Name="Setup" Grid.Row="1" MaxWidth="420" VerticalAlignment="Center"><StackPanel>
   <TextBlock x:Name="AuthTitle" Text="С возвращением" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <TextBlock Text="Войдите или создайте аккаунт, чтобы находить людей и писать им." FontSize="16" TextWrapping="Wrap" Foreground="#66766C" Margin="0,0,0,20"/>
   <TextBlock Text="Юзернейм" Margin="0,0,0,6"/><TextBox x:Name="Username" MaxLength="25"/><TextBlock Text="3–24 символа: латинские буквы, цифры, _" FontSize="12" Foreground="#758478" Margin="0,5,0,12"/>
   <TextBlock Text="Пароль" Margin="0,0,0,6"/><PasswordBox x:Name="Password" MaxLength="128"/><TextBlock Text="От 8 символов" FontSize="12" Foreground="#758478" Margin="0,5,0,12"/>
   <StackPanel x:Name="ConfirmRow" Visibility="Collapsed"><TextBlock Text="Повторите пароль" Margin="0,0,0,6"/><PasswordBox x:Name="Confirm" MaxLength="128" Margin="0,0,0,12"/></StackPanel>
   <Button x:Name="Auth" Content="Войти" HorizontalContentAlignment="Center"/><Button x:Name="AuthMode" Content="Нет аккаунта? Регистрация" Background="Transparent" Foreground="#265C48" HorizontalContentAlignment="Center" Margin="0,6,0,0"/>
   <TextBlock Text="Запомните пароль: восстановление через почту пока недоступно." TextWrapping="Wrap" FontSize="12" Foreground="#758478" Margin="0,10,0,0"/>
  </StackPanel></Grid>
  <Grid x:Name="Main" Grid.Row="1" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Найти человека" FontSize="19" FontWeight="SemiBold"/><TextBox x:Name="Query" MaxLength="25" Margin="0,12,0,8" ToolTip="@username"/><Button x:Name="Search" Content="Найти по юзернейму" HorizontalContentAlignment="Center"/></StackPanel>
    <ScrollViewer Grid.Row="1" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,12"><StackPanel x:Name="Results"/></ScrollViewer>
    <DockPanel Grid.Row="2"><TextBlock Text="Сообщения" DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Chats"/></ScrollViewer></DockPanel>
   </Grid>
   <TextBlock x:Name="Empty" Grid.Column="2" Text="Ваши разговоры — здесь.&#10;Найдите человека по юзернейму." FontSize="22" TextWrapping="Wrap" Foreground="#758478" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"/>
   <Grid x:Name="Chat" Grid.Column="2" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="White" CornerRadius="12" Padding="18"><DockPanel><Button x:Name="Call" Content="☎ Позвонить" DockPanel.Dock="Right" HorizontalAlignment="Right"/><StackPanel><TextBlock x:Name="Peer" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="Presence" Text="Личная переписка" Foreground="#758478" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
    <ScrollViewer x:Name="Scroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16"><StackPanel x:Name="Messages"/></ScrollViewer>
    <StackPanel Grid.Row="2"><Border x:Name="PhotoPreview" Visibility="Collapsed" Background="White" CornerRadius="10" Padding="8" Margin="0,0,0,8"><DockPanel><Button x:Name="RemovePhoto" Content="×" DockPanel.Dock="Right" ToolTip="Убрать фото"/><TextBlock Text="Фото готово к отправке" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0"/><Image x:Name="PendingPhoto" Height="70" HorizontalAlignment="Left"/></DockPanel></Border>
    <Border x:Name="VoiceRecording" Visibility="Collapsed" Background="White" CornerRadius="10" Padding="8" Margin="0,0,0,8"><DockPanel><Button x:Name="CancelVoice" Content="Отмена" DockPanel.Dock="Right"/><TextBlock x:Name="RecordingTime" Foreground="Firebrick" VerticalAlignment="Center" FontSize="15" Margin="8"/></DockPanel></Border>
    <Border x:Name="VoicePreview" Visibility="Collapsed" Background="White" CornerRadius="10" Padding="8" Margin="0,0,0,8"><DockPanel><Button x:Name="RemoveVoice" Content="×" DockPanel.Dock="Right" ToolTip="Удалить голосовую запись"/><Button x:Name="PlayDraftVoice" Content="▶ Прослушать" HorizontalAlignment="Left"/></DockPanel></Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="Attach" Content="+" FontSize="24" Margin="0,0,8,0" ToolTip="Прикрепить фотографию"/><TextBox x:Name="Draft" Grid.Column="1" MinHeight="58" MaxHeight="140" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000"/><Button x:Name="Microphone" Grid.Column="2" Content="🎤" FontSize="20" Margin="8,0,0,0" ToolTip="Записать голосовое сообщение"/><Button x:Name="Send" Grid.Column="3" Content="↑" FontSize="22" Margin="10,0,0,0" ToolTip="Отправить"/></Grid></StackPanel>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="Status" Text="Рядом 2.3 · Личные сообщения" TextWrapping="Wrap" Foreground="#758478" FontSize="12"/><TextBlock Text="Новые сообщения загружаются, пока приложение открыто." FontSize="11" Foreground="#8B968D" Margin="0,5,0,0"/></StackPanel>
 </Grid>
</Window>
