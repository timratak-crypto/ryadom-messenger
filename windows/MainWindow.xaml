<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Рядом" Width="1180" Height="820" MinWidth="820" MinHeight="660" WindowStartupLocation="CenterScreen" Background="{DynamicResource Paper}" FontFamily="Segoe UI" Foreground="#183C32" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
<Window.Resources>
 <Color x:Key="AccentColor">#176B53</Color><Color x:Key="AccentDeep">#103F34</Color><Color x:Key="AccentLight">#CAE2D8</Color><Color x:Key="AccentPale">#E9F3EE</Color>
 <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}"/><SolidColorBrush x:Key="AccentSoft" Color="{DynamicResource AccentPale}"/><SolidColorBrush x:Key="Paper" Color="#F6F8F7"/>

 <Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="18,12"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.66"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="TextBox"><Setter Property="Padding" Value="14,12"/><Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="#183C32"/><Setter Property="Background" Value="#F3F7F5"/><Setter Property="BorderBrush" Value="#DCE8E2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="SelectionBrush" Value="#A2D8C5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="PasswordBox"><Setter Property="Padding" Value="14,12"/><Setter Property="FontSize" Value="15"/><Setter Property="Background" Value="#F3F7F5"/><Setter Property="BorderBrush" Value="#DCE8E2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ScrollViewer"><Setter Property="PanningMode" Value="VerticalOnly"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/></Style>
 <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Style>
 <Style x:Key="Icon" TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="19"/></Style>
</Window.Resources>
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DockPanel Margin="6,0,6,18"><Button x:Name="Settings" DockPanel.Dock="Right" Content="Настройки" Style="{StaticResource Quiet}" Margin="8,0,0,0" Visibility="Collapsed"/><Button x:Name="Logout" Content="Выйти" DockPanel.Dock="Right" Style="{StaticResource Quiet}" HorizontalAlignment="Right" Visibility="Collapsed" Padding="16,10"/><StackPanel Orientation="Horizontal"><Border Width="44" Height="44" CornerRadius="15" Background="{DynamicResource Accent}" Margin="0,0,12,0"><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Рядом" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="Me" Text="Ближе, чем кажется" Foreground="#6C8278" FontSize="12"/></StackPanel></StackPanel></DockPanel>
 <Grid x:Name="Setup" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="440"/></Grid.ColumnDefinitions>
  <Border CornerRadius="28" Margin="0,0,20,0" ClipToBounds="True"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{DynamicResource AccentDeep}"/><GradientStop Color="{DynamicResource AccentColor}" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Ellipse Width="340" Height="340" Stroke="{DynamicResource Accent}" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-90,-100,0"/><Ellipse Width="230" Height="230" Stroke="{DynamicResource Accent}" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-35,-45,0"/>
   <StackPanel Margin="32" VerticalAlignment="Center"><TextBlock Text="ДЛЯ СВОИХ ЛЮДЕЙ" FontSize="11" FontWeight="SemiBold" Foreground="#B8DBCD" Margin="0,0,0,28"/><TextBlock Text="Хорошо,&#10;когда близкие&#10;рядом." FontSize="39" LineHeight="49" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Пара слов. Знакомый голос.&#10;Моменты, которыми хочется делиться." TextWrapping="Wrap" FontSize="16" LineHeight="25" Foreground="#CAE2D8" Margin="0,24,0,32"/><Border Background="#397C66" CornerRadius="18,18,18,5" Padding="16" HorizontalAlignment="Left"><TextBlock Text="Как прошёл твой день?" FontSize="15" Foreground="White"/></Border><Border Background="#DDF4E8" CornerRadius="18,18,5,18" Padding="16" Margin="20,12,0,0" HorizontalAlignment="Right"><TextBlock Text="Сейчас всё расскажу ♡" FontSize="15" Foreground="#174E3C"/></Border></StackPanel>
  </Grid></Border>
  <Border Grid.Column="1" Background="White" CornerRadius="28" Padding="32"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel VerticalAlignment="Center" Margin="0,18,0,12"><TextBlock Text="ВАШ ЛИЧНЫЙ МЕССЕНДЖЕР" Foreground="#6C8278" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,20"/><TextBlock x:Name="AuthTitle" Text="С возвращением" FontSize="29" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="Войдите, чтобы продолжить разговор." FontSize="15" TextWrapping="Wrap" Foreground="#6C8278" Margin="0,0,0,28"/>
   <TextBlock Text="Юзернейм" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="Username" MaxLength="25"/><TextBlock Text="3–24 символа: латинские буквы, цифры, _" FontSize="11" Foreground="#6C8278" Margin="0,6,0,20"/><TextBlock Text="Пароль" FontWeight="SemiBold" Margin="0,0,0,8"/><PasswordBox x:Name="Password" MaxLength="128"/><TextBlock Text="От 8 символов" FontSize="11" Foreground="#6C8278" Margin="0,6,0,20"/><StackPanel x:Name="ConfirmRow" Visibility="Collapsed"><TextBlock Text="Повторите пароль" FontWeight="SemiBold" Margin="0,0,0,8"/><PasswordBox x:Name="Confirm" MaxLength="128" Margin="0,0,0,18"/></StackPanel><Button x:Name="Auth" Content="Войти" Height="48"/><Button x:Name="AuthMode" Content="Нет аккаунта? Регистрация" Background="Transparent" Foreground="{DynamicResource Accent}" Margin="0,10,0,0"/><TextBlock Text="Сохраните пароль в надёжном месте. Восстановление через почту пока недоступно." TextWrapping="Wrap" FontSize="11" Foreground="#8A9B92" Margin="0,22,0,0"/></StackPanel></ScrollViewer></Border>
 </Grid>
 <Grid x:Name="Main" Grid.Row="1" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="308"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="White" CornerRadius="24" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><DockPanel Margin="2,4,0,18"><Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="8,4"><TextBlock Text="ЛИЧНОЕ" Foreground="{DynamicResource Accent}" FontSize="9" FontWeight="Bold"/></Border><TextBlock Text="Сообщения" FontSize="23" FontWeight="SemiBold"/></DockPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBox x:Name="Query" MaxLength="25" ToolTip="Введите @username" AutomationProperties.Name="Поиск по юзернейму"/><Button x:Name="Search" Grid.Column="2" FontFamily="Segoe MDL2 Assets" Content="&#xE721;" Padding="0" FontSize="17" ToolTip="Найти по юзернейму" AutomationProperties.Name="Найти человека"/></Grid><TextBlock Text="Найдите человека по @username" Foreground="#8A9B92" FontSize="11" Margin="4,8,0,6"/></StackPanel><ScrollViewer Grid.Row="1" MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="0,8"><StackPanel x:Name="Results"/></ScrollViewer><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="-4,8,-4,0"><StackPanel x:Name="Chats"/></ScrollViewer></Grid></Border>
  <Border Grid.Column="2" Background="{DynamicResource Paper}" CornerRadius="24" BorderBrush="#FFFFFF" BorderThickness="1"><Grid>
   <Grid x:Name="Empty" Margin="30"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><Grid Width="150" Height="150" Margin="0,0,0,28"><Ellipse Fill="{DynamicResource AccentSoft}"/><Ellipse Margin="16" Stroke="{DynamicResource AccentSoft}" StrokeThickness="1"/><Border Width="74" Height="74" Background="{DynamicResource Accent}" CornerRadius="26" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="-8"/></Border.RenderTransform><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border></Grid><TextBlock Text="Разговор начинается с «привет»" FontSize="25" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="Выберите переписку слева или найдите&#10;близкого человека по юзернейму." Foreground="#7A9185" FontSize="15" LineHeight="24" TextAlignment="Center" Margin="0,14,0,0"/></StackPanel></Grid>
   <Grid x:Name="Chat" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="White" CornerRadius="24,24,0,0" Padding="24,18"><DockPanel><Button x:Name="Call" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Quiet}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,8,0"/><TextBlock Text="Позвонить"/></StackPanel></Button><Border x:Name="PeerAvatar" DockPanel.Dock="Left" Margin="0,0,13,0"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="Peer" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="Presence" Text="Личная переписка" Foreground="#7A9185" FontSize="12" Margin="0,4,0,0"/></StackPanel></DockPanel></Border><ScrollViewer x:Name="Scroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18"><StackPanel x:Name="Messages"/></ScrollViewer><StackPanel Grid.Row="2" Margin="18,0,18,18">
    <Border x:Name="PhotoPreview" Visibility="Collapsed" Background="White" CornerRadius="16" Padding="12" Margin="0,0,0,10"><DockPanel><Button x:Name="RemovePhoto" Content="×" DockPanel.Dock="Right" Style="{StaticResource Quiet}" ToolTip="Убрать фото"/><TextBlock Text="Фото готово к отправке" DockPanel.Dock="Right" Foreground="#6C8278" VerticalAlignment="Center" Margin="12,0"/><Image x:Name="PendingPhoto" Height="70" HorizontalAlignment="Left"/></DockPanel></Border><Border x:Name="VoiceRecording" Visibility="Collapsed" Background="#FFF0EF" CornerRadius="16" Padding="10" Margin="0,0,0,10"><DockPanel><Button x:Name="CancelVoice" Content="Отмена" DockPanel.Dock="Right" Style="{StaticResource Quiet}"/><TextBlock x:Name="RecordingTime" Foreground="#B94E50" VerticalAlignment="Center" FontSize="14" Margin="8"/></DockPanel></Border><Border x:Name="VoicePreview" Visibility="Collapsed" Background="White" CornerRadius="16" Padding="10" Margin="0,0,0,10"><DockPanel><Button x:Name="RemoveVoice" Content="×" DockPanel.Dock="Right" Style="{StaticResource Quiet}" ToolTip="Удалить голосовую запись"/><Button x:Name="PlayDraftVoice" Content="▶ Прослушать" Style="{StaticResource Quiet}" HorizontalAlignment="Left"/></DockPanel></Border>
    <Border Background="White" CornerRadius="20" BorderBrush="#E0EBE5" BorderThickness="1" Padding="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="Attach" Content="&#xE710;" Style="{StaticResource Icon}" Background="Transparent" VerticalAlignment="Bottom" ToolTip="Прикрепить фотографию" AutomationProperties.Name="Прикрепить фотографию"/><Grid Grid.Column="1"><TextBox x:Name="Draft" MinHeight="46" MaxHeight="140" Background="Transparent" BorderThickness="0" Padding="8,12" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000" AutomationProperties.Name="Сообщение"/><TextBlock Text="Напишите сообщение…" Foreground="#91A298" Margin="10,13,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Draft}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button x:Name="Microphone" Grid.Column="2" Content="&#xE720;" Style="{StaticResource Icon}" Background="Transparent" VerticalAlignment="Bottom" ToolTip="Записать голосовое сообщение" AutomationProperties.Name="Записать голосовое сообщение"/><Button x:Name="Send" Grid.Column="3" Content="&#xE724;" Style="{StaticResource Icon}" Background="{DynamicResource Accent}" Foreground="White" VerticalAlignment="Bottom" Margin="4,0,0,0" ToolTip="Отправить" AutomationProperties.Name="Отправить"/></Grid></Border>
   </StackPanel></Grid>
  </Grid></Border>
 </Grid>
 <DockPanel Grid.Row="2" Margin="8,12,8,0"><TextBlock Text="РЯДОМ 2.7.1" DockPanel.Dock="Right" Foreground="#94A79C" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="Status" Text="Личные сообщения, фотографии и звонки" TextWrapping="Wrap" Foreground="#6C8278" FontSize="11"/></DockPanel>
</Grid></Window>